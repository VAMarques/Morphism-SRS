{
  "inlineMath": [
    [
      "$",
      "$"
    ],
    [
      "\\(",
      "\\)"
    ]
  ],
  "displayMath": [
    [
      "$$",
      "$$"
    ],
    [
      "\\[",
      "\\]"
    ]
  ],
  "processEscapes": true,
  "packages": {
    "[+]": [
      "color",
      "ams",
      "boldsymbol",
      "mhchem",
      "mathtools",
      "cancel",
      "cases",
      "centernot",
      "unicode",
      "noerrors",
      "noundefined"
    ],
    "[-]": [
      "autoload",
      "require"
    ]
  },
  "macros": {
    "norm": [
      "{\\left\\|#1\\right\\|}",
      1
    ],
    "abs": [
      "{\\left|#1\\right|}",
      1
    ],
    "parens": [
      "{\\left(#1\\right)}",
      1
    ],
    "inner": [
      "{\\left\\langle #1, #2 \\right\\rangle}",
      2
    ],
    "ph": "{\\textcolor{#60a5fa}{\\varphi}}",
    "ps": "{\\textcolor{#60a5fa}{\\psi}}",
    "ch": "{\\textcolor{#60a5fa}{\\chi}}",
    "ta": "{\\textcolor{#60a5fa}{\\tau}}",
    "gm": "{\\textcolor{#60a5fa}{\\gamma}}",
    "al": "{\\textcolor{#60a5fa}{\\alpha}}",
    "be": "{\\textcolor{#60a5fa}{\\beta}}",
    "eps": "{\\varepsilon}",
    "True": "{\\mathsf{T}}",
    "False": "{\\mathsf{F}}",
    "lthen": "{\\Rightarrow}",
    "liff": "{\\Leftrightarrow}",
    "lxor": "{\\veebar}",
    "biota": "{℩}",
    "d": "\\mathbin{\\!}\\mathrm{d}",
    "RR": "{\\mathbb{R}}",
    "CC": "{\\mathbb{C}}",
    "NN": "{\\mathbb{N}}",
    "ZZ": "{\\mathbb{Z}}",
    "QQ": "{\\mathbb{Q}}",
    "FF": "{\\mathbb{F}}",
    "R": "{\\mathbb{R}}",
    "C": "{\\mathbb{C}}",
    "N": "{\\mathbb{N}}",
    "Z": "{\\mathbb{Z}}",
    "Q": "{\\mathbb{Q}}",
    "F": "{\\mathbb{F}}",
    "Hom": "{\\operatorname{Hom}}",
    "Ker": "{\\operatorname{Ker}}",
    "Im": "{\\operatorname{Im}}",
    "Aut": "{\\operatorname{Aut}}",
    "End": "{\\operatorname{End}}",
    "id": "{\\operatorname{id}}",
    "tensor": "{\\otimes}",
    "bm": [
      "{\\boldsymbol{#1}}",
      1
    ],
    "ce": [
      "{\\mathrm{#1}}",
      1
    ]
  },
  "autoload": {
    "boldsymbol": [],
    "mhchem": [],
    "mathtools": [],
    "cancel": [],
    "cases": [],
    "centernot": [],
    "unicode": []
  }
}
